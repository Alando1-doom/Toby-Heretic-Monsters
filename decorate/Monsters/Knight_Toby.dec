ACTOR Knight_Toby : Knight replaces Knight
{
  Translation "190:205=148:165"
  DropItem "CrossbowAmmoDropped_Toby", 84
  States
  {
  Spawn:
    XNIG AB 10 A_Look
    Loop
  See:
    XNIG A 4 A_Chase
	XNIG A 0 A_PlaySound("knight/walk")
	XNIG B 4 A_Chase
	XNIG C 4 A_Chase
	XNIG C 0 A_PlaySound("knight/walk")
	XNIG D 4 A_Chase
	XNIG A 4 A_Chase
	XNIG A 0 A_PlaySound("knight/walk")
	XNIG B 4 A_Chase
	XNIG C 4 A_Chase
	XNIG C 0 A_PlaySound("knight/walk")
	XNIG D 4 A_Chase
	XNIG A 4 A_Chase
	XNIG A 0 A_PlaySound("knight/walk")
	XNIG B 4 A_Chase
	XNIG C 4 A_Chase
	XNIG C 0 A_PlaySound("knight/walk")
	XNIG D 4 A_Chase
	XNIG A 4 A_Chase
	XNIG A 0 A_PlaySound("knight/walk")
	XNIG B 4 A_Chase
	XNIG C 4 A_Chase
	XNIG C 0 A_PlaySound("knight/walk")
	XNIG D 4 A_Chase
	XNIG A 4 A_Chase
	XNIG A 0 A_PlaySound("knight/walk")
	XNIG B 4 A_Chase
	XNIG C 4 A_Chase
	XNIG C 0 A_PlaySound("knight/walk")
	XNIG D 4 A_Chase
	XNIG A 4 A_Chase
	XNIG A 0 A_PlaySound("knight/walk")
	XNIG B 4 A_Chase
	XNIG C 4 A_Chase
	XNIG C 0 A_PlaySound("knight/walk")
	XNIG D 4 A_Chase
	XNIG A 4 A_Chase
	XNIG A 0 A_PlaySound("knight/walk")
	XNIG B 4 A_Chase
	XNIG C 4 A_Chase
	XNIG C 0 A_PlaySound("knight/walk")
	XNIG D 4 A_Chase
	//XNIG D 0 A_ActiveSound
    Loop
  Melee:
  Missile:
    TNT1 A 0 A_Jump(41, "BloodAxe") // 16% chance to throw a blood axe
  EtherealAxe:
    XNIG E 10 A_FaceTarget
	XNIG E 0 A_PlaySoundEx("knight/charge", "Auto", 0, 0)
    XNIG F 8 A_FaceTarget
	XNIG F 0 A_PlaySound("knight/swing")
    XNIG G 8 A_CustomComboAttack("KnightAxe", 32, 3 * random(1, 8), "hknight/melee")
    XNIG E 10 A_FaceTarget
    XNIG F 8 A_FaceTarget
	XNIG F 0 A_PlaySound("knight/swing")
    XNIG G 8 A_CustomComboAttack("KnightAxe", 32, 3 * random(1, 8), "hknight/melee")
    Goto See
  BloodAxe:
    XNIG H 10 A_FaceTarget
	XNIG H 0 A_PlaySoundEx("knight/charge", "Auto", 0, 0)
    XNIG I 8 A_FaceTarget
	XNIG I 0 A_PlaySound("knight/swing")
    XNIG J 8 A_CustomComboAttack("RedAxe", 32, 3 * random(1, 8), "hknight/melee")
    XNIG H 10 A_FaceTarget
    XNIG I 8 A_FaceTarget
	XNIG I 0 A_PlaySound("knight/swing")
    XNIG J 8 A_CustomComboAttack("RedAxe", 32, 3 * random(1, 8), "hknight/melee")
    Goto See
  Pain:
    XNIG K 3
    XNIG K 3 A_Pain
    Goto See
  Death:
    XNIG L 6
    XNIG M 6 A_Scream
    XNIG N 6
    XNIG O 6 A_NoBlocking
    XNIG PQ 6
    XNIG R -1
    Stop
  }
}

